# Ignore everything by default
*

# Allow specific GTPS files
!gtps-bundle.tar.gz
!gtps-bundle-README.txt
!gtps-local/
!gtps-proxy/

# Allow .gitignore itself and config files
!.gitignore
!/gtps-local/**
!/gtps-proxy/**

# Explicitly block heavy/fat directories regardless
/.hermes/
/.9router/
/.cache/
/.cargo/
/.mysql/
/.npm/
/.local/
/.ssh/
/.venv/
/.cloudflared/
/.openclaw/
/.w3m/
/bangmx-reels.zip
/bangmx-store.zip
/img_*
